{
  "name": "dogfood-2026-portal",
  "version": "1.0.0",
  "description": "DOGFOOD 2026 Hackathon Submission and Judging Platform",
  "main": "src/server/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node src/server/index.js",
    "seed": "node src/server/db/seed.js",
    "test": "node --test --test-concurrency=1 tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "check": "python run.py .dogfood.toml"
  },
  "keywords": [
    "hackathon",
    "judging",
    "submissions",
    "dogfood"
  ],
  "author": "DOGFOOD 2026 Team",
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.1"
  }
}
