# ==========================================
# VERIDICT Production Environment Variables
# ==========================================

# Production Email Transport: Resend HTTPS API (Port 443)
# Free tier supported. Get a free API key at https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=VERIDICT <onboarding@resend.dev>

# Optional Development / Fallback Transport: SMTP
# (Not required for production; only used if RESEND_API_KEY is unset)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_user@example.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=VERIDICT <noreply@veridict.local>
# SMTP_SECURE=false

# Server Configuration
PORT=8080
NODE_ENV=production
